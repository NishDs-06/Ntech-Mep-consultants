---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { projects, statuses, placeOf } from '../data/projects.js';
import { photo } from '../lib/photos.js';

const counts = Object.fromEntries(statuses.map((s) => [s, projects.filter((p) => p.status === s).length]));
---

<Base
  title="Projects — N-Tech MEP Consultants"
  description="Public health, electrical and fire protection projects designed by N-Tech across residential, commercial, healthcare, hospitality and industrial buildings."
>
  <section class="pp wrap" aria-labelledby="pp-title">
    <header class="pp-head">
      <h1 id="pp-title" class="pp-title display" data-reveal-heading>Our projects</h1>
      <p class="pp-lede" data-reveal-up>
        Hotels and homes we have designed plumbing, power and fire services for, finished and in progress.
      </p>
    </header>

    <div class="pp-filters" role="group" aria-label="Filter by status" data-filters>
      <button type="button" class="pp-chip" aria-pressed="true" data-filter="all">
        All <span class="mono">{projects.length}</span>
      </button>
      {
        statuses.map((s) => (
          <button type="button" class="pp-chip" aria-pressed="false" data-filter={s}>
            {s} <span class="mono">{counts[s]}</span>
          </button>
        ))
      }
    </div>
    <p class="sr-only" aria-live="polite" data-filter-status></p>

    <ul class="pp-grid" data-grid>
      {
        projects.map((p, i) => (
          <li class="pp-card" data-status={p.status}>
            <figure class="pp-photo">
              <Image quality={72}
                src={photo(p.photo)}
                alt={p.alt}
                widths={[480, 800, 1200]}
                sizes="(max-width: 600px) 100vw, (max-width: 1100px) 50vw, 33vw"
                loading={i < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </figure>
            <div class="pp-meta">
              <h2 class="pp-name">{p.name}</h2>
              <p class="pp-sub">{placeOf(p)}</p>
              <p class="mono pp-status" data-status={p.status}>{p.status}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .pp {
    padding-top: clamp(140px, 22vh, 220px);
    padding-bottom: clamp(96px, 14vh, 160px);
  }
  .pp-head {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 20px;
    row-gap: 24px;
  }
  .pp-head .eyebrow {
    grid-column: 1 / -1;
  }
  .pp-title {
    grid-column: 1 / span 8;
    font-size: var(--t-2xl);
  }
  .pp-lede {
    grid-column: 9 / -1;
    align-self: end;
    color: var(--mute);
  }
  .pp-filters {
    position: sticky;
    top: 76px;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block: clamp(40px, 7vh, 72px) 32px;
    padding-block: 10px;
  }
  .pp-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--ink-2);
    font-size: var(--t-sm);
    transition:
      background 0.2s ease,
      color 0.2s ease,
      transform 0.16s var(--ease-out);
  }
  .pp-chip .mono {
    color: var(--mute);
  }
  @media (hover: hover) and (pointer: fine) {
    .pp-chip:hover {
      background: var(--ink-3);
    }
  }
  .pp-chip:active {
    transform: scale(0.97);
  }
  .pp-chip[aria-pressed='true'] {
    background: var(--amber);
    color: var(--ink);
  }
  .pp-chip[aria-pressed='true'] .mono {
    color: var(--ink);
  }

  .pp-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(28px, 4vw, 56px) 20px;
  }
  .pp-card[hidden] {
    display: none;
  }
  .pp-card:nth-child(3n + 2) {
    margin-top: clamp(0px, 6vw, 96px);
  }
  .pp-photo {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--ink-3);
  }
  .pp-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition:
      transform 1.2s var(--ease-out),
      filter 0.6s;
    filter: saturate(0.85);
  }
  @media (hover: hover) {
    .pp-card:hover .pp-photo :global(img) {
      transform: scale(1.08);
      filter: saturate(1.05);
    }
  }
  .pp-meta {
    display: grid;
    row-gap: 4px;
    padding-top: 18px;
  }
  .pp-name {
    font-size: var(--t-lg);
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .pp-sub {
    color: var(--mute);
    font-size: var(--t-sm);
  }
  .pp-status {
    margin-top: 6px;
    color: var(--amber);
  }
  .pp-status[data-status='Completed'] {
    color: var(--bone);
  }

  @media (max-width: 1100px) {
    .pp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .pp-card:nth-child(3n + 2) {
      margin-top: 0;
    }
  }
  @media (max-width: 860px) {
    .pp-title,
    .pp-lede {
      grid-column: 1 / -1;
    }
    .pp-filters {
      top: 70px;
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .pp-chip {
      flex: none;
    }
  }
  @media (max-width: 600px) {
    .pp-grid {
      grid-template-columns: 1fr;
    }
    .pp-photo {
      aspect-ratio: 4 / 3;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, lenis, reduceMotion, revealHeading, revealUp } from '../scripts/core.js';

  document.querySelectorAll<HTMLElement>('[data-reveal-heading]').forEach((el) => revealHeading(el));
  document.querySelectorAll<HTMLElement>('[data-reveal-up]').forEach((el) => revealUp(el, el));

  const cards = [...document.querySelectorAll<HTMLElement>('.pp-card')];
  const status = document.querySelector('[data-filter-status]')!;

  if (!reduceMotion) {
    ScrollTrigger.batch(cards, {
      start: 'top 92%',
      once: true,
      onEnter: (batch) =>
        gsap.from(batch, { y: 60, opacity: 0, duration: 1.1, ease: 'expo.out', stagger: 0.08, overwrite: true }),
    });
  }

  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter!;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      const show = cards.filter((c) => f === 'all' || c.dataset.status === f);
      cards.forEach((c) => (c.hidden = !show.includes(c)));
      status.textContent = `Showing ${show.length} ${f === 'all' ? '' : f.toLowerCase() + ' '}projects`;
      if (!reduceMotion) {
        gsap.fromTo(show, { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, ease: 'expo.out', stagger: 0.04, overwrite: true });
      }
      ScrollTrigger.refresh();
      // The list may have shrunk under the reader — bring its top back into view.
      const grid = document.querySelector<HTMLElement>('[data-grid]')!;
      if (grid.getBoundingClientRect().top < 0) {
        const y = grid.getBoundingClientRect().top + scrollY - 150;
        lenis ? lenis.scrollTo(y, { duration: 1.2 }) : scrollTo({ top: y });
      }
    }),
  );
</script>
