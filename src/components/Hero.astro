---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { services } from '../data/services.js';
import { site } from '../data/site.js';
---

<!--
  The brochure cover, rebuilt: two vine panels with a band of cube wall between.
  On load the band starts closed (a curtain of the same vine field, so the
  loader's wipe hands over seamlessly) and splits open from the middle; on
  scroll the panels slide away and the camera pushes into the wall. Both
  images are baked at build time (src/pages/hero/*) and only moved with transforms.
-->
<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-stage">
    <div class="hero-wall" aria-hidden="true" data-hero-wall>
      <div class="hero-wall-turn" data-hero-turn>
        <img src="/hero/cubes.webp" alt="" width="2400" height="1300" decoding="async" fetchpriority="high" data-hero-img />
      </div>
      <div class="hero-wall-shade"></div>
      <div class="hero-wall-fade" data-hero-fade-out></div>
    </div>

    <div class="hero-band wrap" data-hero-lockup>
      <h1 id="hero-title" class="hero-lockup">
        <Logo class="hero-logo" />
        <span class="hero-tag" data-hero-tag>MEP Consultants</span>
      </h1>
    </div>

    <div class="hero-curtain" aria-hidden="true">
      <div class="hero-curtain-half" data-curtain="top">
        <div class="hero-curtain-art" style="background-image: url(/hero/vines.svg)"></div>
        <span class="hero-curtain-edge" data-curtain-edge></span>
      </div>
      <div class="hero-curtain-half" data-curtain="bottom">
        <div class="hero-curtain-art" style="background-image: url(/hero/vines.svg)"></div>
        <span class="hero-curtain-edge" data-curtain-edge></span>
      </div>
    </div>

    <div class="hero-panel hero-panel--top" data-hero-panel="top">
      <div class="hero-shut" data-hero-shut="top">
        <div class="hero-art" style="background-image: url(/hero/vines.svg)" aria-hidden="true"></div>
        <div class="hero-panel-body wrap">
          <p class="hero-meta mono" data-hero-line>Building services design</p>
          <p class="hero-meta mono" data-hero-line>
            {site.offices.map((o, i) => (i ? <><span class="hero-sep">/</span>{o.city}</> : o.city))}
          </p>
        </div>
        <span class="hero-rule" data-hero-rule></span>
      </div>
    </div>

    <div class="hero-panel hero-panel--bottom" data-hero-panel="bottom">
      <div class="hero-shut" data-hero-shut="bottom">
        <div class="hero-art" style="background-image: url(/hero/vines.svg)" aria-hidden="true"></div>
        <span class="hero-rule" data-hero-rule></span>
        <div class="hero-panel-body wrap">
          <p class="hero-lede" data-hero-lede>
            Plumbing, power and fire safety for homes, hospitals, offices and plants, drawn as one coordinated set.
          </p>
          <div class="hero-act" data-hero-act>
            <a href="#projects" class="btn">
              See our work
              <span class="btn-icon"><Icon name="solar:arrow-right-linear" /></span>
            </a>
            <a href="#contact" class="hero-link">Start a project</a>
          </div>
        </div>
        <ul class="hero-foot wrap" data-hero-foot>
          {services.map((s) => <li>{s.short}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    --top: 33svh;
    --band: 31svh;
    position: relative;
    height: 100svh;
    background: var(--ink);
  }
  /* The scroll sequence needs room to play; without motion it's a plain poster */
  @media (prefers-reduced-motion: no-preference) {
    .hero {
      height: 210svh;
    }
  }
  .hero-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: clip;
    isolation: isolate;
  }

  /* ---------- Cube wall ---------- */
  .hero-wall {
    position: absolute;
    inset: 0;
    overflow: clip;
    background: #020204;
  }
  /* The wall is a pre-rendered perspective image (src/lib/cubes.js); scroll only moves it */
  .hero-wall-turn {
    position: absolute;
    inset: 0;
    transform-origin: 62% 50%;
    will-change: transform;
  }
  .hero-wall-turn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 50%;
  }
  .hero-wall-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(2 2 4 / 0.78) 0%, rgb(2 2 4 / 0.45) 50%, transparent 78%),
      linear-gradient(to bottom, rgb(2 2 4 / 0.45), transparent 28%, transparent 72%, rgb(2 2 4 / 0.45));
  }
  .hero-wall-fade {
    position: absolute;
    inset: 0;
    background: var(--ink);
    opacity: 0;
  }

  /* ---------- Lockup in the band ---------- */
  .hero-band {
    position: absolute;
    inset: var(--top) 0 auto;
    height: var(--band);
    display: flex;
    align-items: center;
  }
  .hero-lockup {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3em 0.55em;
    font-size: clamp(2.75rem, min(6.4vw, 11svh), 7rem);
    font-weight: inherit;
  }
  /* The brochure wordmark: blue letters in a thick white sticker outline */
  .hero-lockup :global(.logo-word) {
    color: var(--poster-blue);
    -webkit-text-stroke: 0.16em #fff;
    paint-order: stroke fill;
    filter: drop-shadow(0 0.05em 0.06em rgb(0 0 0 / 0.55));
  }
  .hero-lockup :global(.logo-dash) {
    color: inherit;
  }
  .hero-tag {
    font-family: var(--f-tag);
    font-size: 0.34em;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--amber);
    text-shadow:
      0 2px 0 rgb(0 0 0 / 0.5),
      0 0 24px rgb(0 0 0 / 0.75);
  }

  /* ---------- Curtain over the band (entrance only, added by JS) ---------- */
  .hero-curtain {
    display: none;
    position: absolute;
    inset: var(--top) 0 auto;
    height: var(--band);
    z-index: 1;
  }
  :global(.is-shut) .hero-curtain {
    display: block;
  }
  .hero-curtain-half {
    position: absolute;
    inset-inline: 0;
    height: 50%;
    overflow: clip;
    will-change: transform;
  }
  .hero-curtain-half[data-curtain='top'] {
    top: 0;
  }
  .hero-curtain-half[data-curtain='bottom'] {
    top: 50%;
  }
  /* Same viewport-sized field as the panels, so the closed hero reads as one sheet */
  .hero-curtain-art {
    position: absolute;
    inset-inline: 0;
    height: 100svh;
    background: #0e0880 50% 50% / cover no-repeat;
    will-change: transform;
  }
  [data-curtain='top'] .hero-curtain-art {
    top: calc(var(--top) * -1);
  }
  [data-curtain='bottom'] .hero-curtain-art {
    top: calc((var(--top) + var(--band) / 2) * -1);
  }
  .hero-curtain-art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to bottom, rgb(2 1 30 / 0.3) 0 1px, transparent 1px 3px);
  }
  .hero-curtain-edge {
    position: absolute;
    inset-inline: 0;
    height: 1px;
    background: rgb(236 235 245 / 0.7);
    transform-origin: 50% 50%;
  }
  [data-curtain='top'] .hero-curtain-edge {
    bottom: 0;
  }
  [data-curtain='bottom'] .hero-curtain-edge {
    top: 0;
  }

  /* ---------- Vine panels ---------- */
  .hero-panel {
    position: absolute;
    inset-inline: 0;
    z-index: 2;
    will-change: transform;
  }
  .hero-panel--top {
    top: 0;
    height: var(--top);
  }
  .hero-panel--bottom {
    top: calc(var(--top) + var(--band));
    bottom: 0;
  }
  .hero-shut {
    position: relative;
    height: 100%;
    overflow: clip;
    display: flex;
    flex-direction: column;
  }
  /* Both panels show the same viewport-sized image, so the field reads as one sheet */
  .hero-art {
    position: absolute;
    inset-inline: 0;
    height: 100svh;
    z-index: -1;
    background: #0e0880 50% 50% / cover no-repeat;
  }
  .hero-panel--top .hero-art {
    top: 0;
  }
  .hero-panel--bottom .hero-art {
    bottom: 0;
  }
  .hero-art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to bottom, rgb(2 1 30 / 0.3) 0 1px, transparent 1px 3px);
  }

  .hero-rule {
    display: block;
    height: 1px;
    flex: none;
    background: rgb(236 235 245 / 0.7);
    transform-origin: 0 50%;
  }
  .hero-panel--bottom .hero-rule {
    transform-origin: 100% 50%;
  }

  .hero-panel--top .hero-panel-body {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 16px;
  }
  .hero-meta {
    color: rgb(236 235 245 / 0.78);
  }
  .hero-sep {
    color: var(--amber);
    padding-inline: 0.5em;
  }

  .hero-panel--bottom .hero-panel-body {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 20px;
    align-content: start;
    padding-top: clamp(24px, 4.5svh, 48px);
  }
  .hero-lede {
    grid-column: 1 / span 6;
    font-size: clamp(1.25rem, 1.1vw + 0.8rem, 1.875rem);
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: -0.012em;
    max-width: 30ch;
    text-wrap: balance;
  }
  .hero-act {
    grid-column: 9 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 12px 28px;
    align-self: start;
  }
  .hero-link {
    position: relative;
    font-weight: 600;
    font-size: var(--t-sm);
    padding-block: 6px;
  }
  .hero-link::after {
    content: '';
    position: absolute;
    inset: auto 0 2px;
    height: 1px;
    background: currentColor;
    transform-origin: right;
    transition: transform 0.4s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .hero-link:hover::after {
      transform: scaleX(0);
    }
  }

  /* Poster footer: the disciplines spread in amber across a hairline */
  .hero-foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 16px 20px;
    border-top: 1px solid rgb(236 235 245 / 0.35);
    background-clip: padding-box;
  }
  .hero-foot li {
    color: var(--amber);
    font-size: var(--t-sm);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .hero {
      --top: 26svh;
      --band: 24svh;
    }
    .hero-lede {
      grid-column: 1 / -1;
    }
    .hero-act {
      grid-column: 1 / -1;
      justify-content: flex-start;
      margin-top: 24px;
    }
  }
  @media (max-width: 560px) {
    .hero-panel--top .hero-panel-body > :last-child {
      display: none;
    }
    .hero-lockup {
      font-size: clamp(2.5rem, 13vw, 3.5rem);
      gap: 0.25em;
    }
    .hero-foot li {
      font-size: var(--t-xs);
      letter-spacing: 0.06em;
    }
  }
</style>
