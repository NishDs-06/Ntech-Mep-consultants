---
import Logo from './Logo.astro';
---

<div class="loader" data-loader aria-hidden="true">
  <div class="loader-grid"></div>
  <div class="loader-center" data-loader-center>
    <Logo class="loader-logo" wordmark={false} />
    <div class="loader-word" data-loader-word>
      <span>N</span><span class="dash">-</span><span>T</span><span>e</span><span>c</span><span>h</span>
    </div>
    <p class="loader-tag" data-loader-tag>MEP Consultants</p>
  </div>
  <div class="loader-foot wrap">
    <span class="loader-disc">Public health <i>/</i> Electrical <i>/</i> Fire protection</span>
    <span class="loader-count"><span data-loader-count>0</span><i>%</i></span>
  </div>
  <div class="loader-wipe" data-loader-wipe style="background-image: url(/hero/vines.svg)"></div>
</div>

<style>
  .loader {
    display: none;
  }
  /* Deep brochure blue rather than flat black: the same night the vine field sits in */
  :global(.js) .loader {
    position: fixed;
    inset: 0;
    z-index: 150;
    display: grid;
    place-items: center;
    background: #06041d;
    animation: loader-failsafe 0.6s 10s forwards;
  }
  :global(.js.intro-seen) .loader {
    display: none;
  }
  /* While the loader plays, the hero under it isn't painted at all, from the
     very first frame (the script shows it again in the hold). Failsafe: if the
     script never runs, it comes back on its own with the loader's failsafe. */
  :global(.intro-play [data-hero]) {
    visibility: hidden;
    animation: hero-failsafe 0s 10s forwards;
  }
  @keyframes hero-failsafe {
    to {
      visibility: visible;
    }
  }
  @keyframes loader-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
  /* The hero's vines, dimmed and scanlined, instead of a generic hairline grid.
     It fades and settles in, so it gets its own layer: drawn once, then only
     moved by the compositor. The vignette is painted on top, not a mask,
     because a mask on a moving full-screen layer is redrawn every frame. */
  .loader-grid {
    position: absolute;
    inset: 0;
    background: #0e0880 url(/hero/vines.svg) 50% 50% / cover no-repeat;
    opacity: 0.32;
    will-change: transform, opacity;
  }
  .loader-grid::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(85% 75% at 50% 50%, transparent 20%, #06041d 85%),
      repeating-linear-gradient(to bottom, rgb(2 1 30 / 0.45) 0 1px, transparent 1px 3px);
  }
  .loader-center {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(10px, 2vw, 26px);
  }
  .loader-center :global(.loader-logo) {
    font-size: clamp(40px, 12vw, 172px);
  }
  /* The brochure wordmark: blue letters in a thick white sticker outline */
  .loader-word {
    display: flex;
    font-size: clamp(28px, 11vw, 168px);
    font-family: var(--f-logo);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--poster-blue);
    -webkit-text-stroke: 0.16em #fff;
    paint-order: stroke fill;
    /* text-shadow rides along with each rising letter; a filter on the whole
       word would be re-rendered on every frame of the rise */
    text-shadow: 0 0.05em 0.06em rgb(0 0 0 / 0.55);
    /* room for the outline inside the rise mask */
    overflow: clip;
    padding: 0.14em 0.12em;
    margin: -0.14em -0.12em;
  }
  .loader-word span {
    display: inline-block;
    will-change: transform;
  }
  /* Same wide, heavy amber line as on the cover */
  .loader-tag {
    position: absolute;
    right: 0.2em;
    bottom: -2.1em;
    margin: 0;
    white-space: nowrap;
    font-family: var(--f-display);
    font-size: clamp(12px, 1.7vw, 26px);
    font-stretch: 125%;
    font-weight: 900;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--amber);
  }
  .loader-foot {
    position: absolute;
    inset: auto 0 max(24px, env(safe-area-inset-bottom));
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
  }
  .loader-disc {
    font-size: var(--t-sm);
    font-weight: 500;
    color: rgb(236 235 245 / 0.72);
  }
  .loader-disc i {
    font-style: normal;
    color: var(--amber);
    padding: 0 0.45em;
  }
  /* A quiet readout in the logo's face, not a billboard number */
  .loader-count {
    font-family: var(--f-logo);
    font-size: clamp(28px, 3.4vw, 48px);
    line-height: 1;
    color: var(--bone);
    font-variant-numeric: tabular-nums;
  }
  .loader-count i {
    font-style: normal;
    color: var(--amber);
    margin-left: 0.06em;
  }
  /* Wipes in the hero's own dark-blue vine field, so the hand-off is seamless */
  .loader-wipe {
    position: absolute;
    inset: 0;
    background: #0e0880 50% 50% / cover no-repeat;
    clip-path: inset(100% 0 0 0);
  }
  /* the hero's scanlines, so the wipe and the closed hero are the same picture */
  .loader-wipe::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to bottom, rgb(2 1 30 / 0.3) 0 1px, transparent 1px 3px);
  }

  @media (max-width: 560px) {
    .loader-disc {
      display: none;
    }
    .loader-foot {
      justify-content: flex-end;
    }
  }
</style>
