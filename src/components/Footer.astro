---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site } from '../data/site.js';
const year = new Date().getFullYear();
---

<footer class="ft" id="contact" aria-labelledby="ft-title">
  <div class="ft-inner wrap">
    <div class="ft-top">
      <p class="eyebrow">Contact</p>
      <h2 id="ft-title" class="ft-title display" data-reveal-heading>Have a building on the <em>drawing board?</em></h2>
      <p class="ft-lede" data-reveal-up>
        Send us the architectural set — or just a site plan and a brief. We will come back within two working days with
        a scope and fee.
      </p>
    </div>

    <a href={`mailto:${site.email}`} class="ft-email display" data-ft-email>
      <span class="ft-email-text">{site.email}</span>
      <span class="ft-email-icon"><Icon name="solar:arrow-right-up-linear" /></span>
    </a>

    <div class="ft-grid">
      <div class="ft-col">
        <p class="mono ft-label">Call</p>
        {
          site.phones.map((p) => (
            <a href={`tel:${p.tel}`} class="ft-link">
              <span class="mono ft-sub">{p.label}</span>
              {p.display}
            </a>
          ))
        }
      </div>
      {
        site.offices.map((o) => (
          <div class="ft-col">
            <p class="mono ft-label">{o.city} office</p>
            <address>
              {o.lines.map((l) => (
                <span>{l}</span>
              ))}
            </address>
          </div>
        ))
      }
      <div class="ft-col">
        <p class="mono ft-label">Elsewhere</p>
        <a href={site.linkedin} class="ft-link">LinkedIn</a>
        <a href="/projects" class="ft-link">All projects</a>
        <a href="/credits" class="ft-link">Image credits</a>
      </div>
    </div>

    <div class="ft-mark" aria-hidden="true">
      <Logo wordmark={false} class="ft-sphere" />
      <span class="display">N-Tech</span>
    </div>

    <div class="ft-bottom mono">
      <span>© {year} {site.full}</span>
      <span>Public health · Electrical · Fire protection</span>
      <a href="#main" class="ft-top-link">
        Back to top <Icon name="solar:arrow-up-linear" />
      </a>
    </div>
  </div>
</footer>

<style>
  /* Black, white and one blue: a deep glow rising behind the wordmark */
  .ft {
    --ft-line: rgb(255 255 255 / 0.12);
    --ft-blue: #5b6cff;
    position: relative;
    background:
      radial-gradient(70% 55% at 50% 100%, rgb(27 18 204 / 0.32), transparent 70%),
      #030208;
    color: var(--bone);
    overflow: clip;
  }
  .ft-inner {
    padding-top: clamp(96px, 16vh, 180px);
  }
  .ft-top {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 20px;
    row-gap: 24px;
  }
  .ft-top .eyebrow {
    grid-column: 1 / -1;
  }
  .ft-top .eyebrow::before {
    background: var(--ft-blue);
  }
  .ft-title {
    grid-column: 1 / span 8;
    font-size: var(--t-2xl);
  }
  .ft-title :global(em) {
    color: var(--ft-blue);
  }
  .ft-lede {
    grid-column: 9 / -1;
    align-self: end;
    color: var(--mute);
    text-wrap: pretty;
  }
  .ft-email {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: clamp(48px, 9vh, 110px);
    padding-block: 26px;
    border-block: 1px solid var(--ft-line);
    font-size: clamp(1.6rem, 5.4vw, 6rem);
    overflow-wrap: anywhere;
  }
  .ft-email-text {
    background: linear-gradient(var(--ft-blue), var(--ft-blue)) 0 100% / 0% 3px no-repeat;
    transition: background-size 0.7s var(--ease-out), color 0.4s;
  }
  .ft-email-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: clamp(48px, 6vw, 96px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--bone);
    color: #030208;
    font-size: 0.45em;
    transition: transform 0.6s var(--ease-out);
  }
  @media (hover: hover) {
    .ft-email:hover .ft-email-text {
      background-size: 100% 3px;
    }
    .ft-email:hover .ft-email-icon {
      transform: rotate(45deg);
    }
  }
  .ft-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px 20px;
    padding-block: clamp(40px, 7vh, 72px);
  }
  .ft-col {
    display: grid;
    align-content: start;
    gap: 10px;
  }
  .ft-label {
    color: var(--mute);
    margin-bottom: 4px;
  }
  .ft-sub {
    display: block;
    color: rgb(255 255 255 / 0.45);
    font-size: 10px;
  }
  .ft-link {
    width: fit-content;
    font-size: var(--t-lg);
    background: linear-gradient(currentColor, currentColor) 0 100% / 0% 1px no-repeat;
    transition: background-size 0.5s var(--ease-out);
  }
  .ft-link:hover {
    background-size: 100% 1px;
  }
  address {
    display: grid;
    font-style: normal;
    font-size: var(--t-lg);
    line-height: 1.4;
  }
  .ft-mark {
    display: flex;
    align-items: center;
    margin-top: 12px;
    font-size: clamp(3rem, 16.5vw, 19rem);
    line-height: 0.8;
    white-space: nowrap;
  }
  .ft-mark .display {
    font-family: var(--f-logo);
    font-weight: 400;
    font-size: 0.62em;
    /* tuck into the globe's open side, as in the logo */
    margin-left: -0.7em;
    letter-spacing: -0.04em;
    color: transparent;
    background: linear-gradient(180deg, rgb(91 108 255 / 0.5), rgb(91 108 255 / 0) 88%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-stroke: 1px rgb(120 135 255 / 0.85);
  }
  .ft-mark :global(.ft-sphere) {
    font-size: 0.62em;
  }
  .ft-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
    padding-block: 28px max(28px, env(safe-area-inset-bottom));
    margin-top: clamp(20px, 3vw, 40px);
    border-top: 1px solid var(--ft-line);
    color: rgb(255 255 255 / 0.55);
  }
  .ft-top-link {
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }

  @media (max-width: 860px) {
    .ft-title,
    .ft-lede {
      grid-column: 1 / -1;
    }
    .ft-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
