---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../data/site.js';
---

<header class="nav" data-nav>
  <div class="nav-inner wrap">
    <a href="/" class="nav-logo" aria-label="N-Tech home">
      <Logo id="nav-logo" />
    </a>
    <nav class="nav-links" aria-label="Primary">
      {
        site.nav.map((l, i) => (
          <a href={l.href} class="nav-link">
            <span class="nav-label"><span data-text={l.label}>{l.label}</span></span>
          </a>
        ))
      }
    </nav>
    <a href="#contact" class="btn nav-cta">
      Start a project
      <span class="btn-icon"><Icon name="solar:arrow-right-up-linear" /></span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-sheet" data-nav-toggle>
      <span class="nav-toggle-label">Menu</span>
      <span class="nav-toggle-bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="nav-sheet" id="nav-sheet" data-nav-sheet hidden>
    <nav class="wrap nav-sheet-inner" aria-label="Mobile">
      {
        site.nav.map((l, i) => (
          <a href={l.href} class="nav-sheet-link display" data-nav-close>
            {l.label}
          </a>
        ))
      }
      <div class="nav-sheet-foot">
        <a href={`mailto:${site.email}`} class="mono">{site.email}</a>
        <a href={`tel:${site.phones[0].tel}`} class="mono">{site.phones[0].display}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    padding-top: max(14px, env(safe-area-inset-top));
    transition: transform 0.6s var(--ease-out);
  }
  .nav.is-hidden {
    transform: translateY(-110%);
  }
  .nav::before {
    content: '';
    position: absolute;
    inset: 0 0 -30px;
    background: linear-gradient(var(--ink) 0%, rgb(5 4 13 / 0.7) 45%, transparent);
    opacity: 0;
    transition: opacity 0.5s;
    pointer-events: none;
  }
  .nav.is-scrolled::before {
    opacity: 1;
  }
  .nav-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 24px;
    height: 60px;
  }
  .nav-logo {
    font-size: 1.35rem;
    margin-right: auto;
  }
  .nav-links {
    display: flex;
    gap: clamp(18px, 2.4vw, 40px);
  }
  .nav-link {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    font-size: var(--t-sm);
    font-weight: 500;
    padding: 8px 0;
  }
  .nav-label {
    position: relative;
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
  }
  .nav-label > span {
    position: relative;
    display: inline-block;
    transition: transform 0.5s var(--ease-out);
  }
  .nav-label > span::after {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 100%;
    color: var(--amber);
  }
  @media (hover: hover) {
    .nav-link:hover .nav-label > span {
      transform: translateY(-100%);
    }
  }
  .nav-cta {
    min-height: 44px;
  }
  .nav-toggle {
    display: none;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 6px 0 16px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    font-size: var(--t-sm);
    font-weight: 500;
  }
  .nav-toggle-bars {
    display: grid;
    gap: 5px;
    place-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--amber);
  }
  .nav-toggle-bars i {
    display: block;
    width: 14px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.4s var(--ease-out);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bars i:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bars i:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .nav-sheet {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--ultra);
    padding-top: 110px;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.7s var(--ease-in-out);
  }
  .nav-sheet.is-open {
    clip-path: inset(0 0 0 0);
  }
  .nav-sheet-inner {
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding-bottom: 32px;
  }
  .nav-sheet-link {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: clamp(2.5rem, 12vw, 4.5rem);
    padding: 6px 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.18);
  }
  .nav-sheet-foot {
    margin-top: auto;
    display: grid;
    gap: 10px;
  }

  @media (max-width: 860px) {
    .nav-links,
    .nav-cta {
      display: none;
    }
    .nav-toggle {
      display: inline-flex;
    }
  }
</style>

<script>
  import { lenis } from '../scripts/core.js';

  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const toggle = nav.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
  const sheet = nav.querySelector<HTMLElement>('[data-nav-sheet]')!;

  let open = false;
  const setOpen = (v: boolean) => {
    open = v;
    toggle.setAttribute('aria-expanded', String(v));
    toggle.querySelector('.nav-toggle-label')!.textContent = v ? 'Close' : 'Menu';
    if (v) {
      sheet.hidden = false;
      requestAnimationFrame(() => sheet.classList.add('is-open'));
      lenis?.stop();
    } else {
      sheet.classList.remove('is-open');
      lenis?.start();
      sheet.addEventListener('transitionend', () => !open && (sheet.hidden = true), { once: true });
    }
  };
  toggle.addEventListener('click', () => setOpen(!open));
  sheet.querySelectorAll('[data-nav-close]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && open && setOpen(false));

  // Hide on scroll down, reveal on scroll up.
  let last = 0;
  const onScroll = (y: number) => {
    nav.classList.toggle('is-scrolled', y > 40);
    nav.classList.toggle('is-hidden', y > last && y > 240 && !open);
    last = y;
  };
  if (lenis) lenis.on('scroll', ({ scroll }: { scroll: number }) => onScroll(scroll));
  else addEventListener('scroll', () => onScroll(scrollY), { passive: true });
</script>
