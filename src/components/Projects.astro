---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { completed, ongoing, placeOf } from '../data/projects.js';
import { photo } from '../lib/photos.js';
---

<section class="pj" id="projects" aria-labelledby="pj-title" data-pj>
  <header class="pj-head wrap">
    <h2 id="pj-title" class="pj-title display" data-reveal-heading>Projects, built and <em>under way.</em></h2>
    <p class="pj-intro" data-reveal-up>
      Three finished, three on the drawing board. Each one drawn as a single coordinated set of plumbing, power and
      fire services.
    </p>
  </header>

  <div class="pj-stage" data-pj-stage>
    {
      completed.map((p, i) => (
        <article class="pj-item" data-pj-item aria-labelledby={`pj-${p.id}`}>
          <div class="pj-move" data-pj-move>
            <div class="pj-frame" data-pj-frame>
              <Image
                quality={72}
                src={photo(p.photo)}
                alt={p.alt}
                widths={[800, 1280, 1920]}
                sizes="100vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                data-pj-img
              />
              <div class="pj-shade" />
            </div>
            <p class="pj-tag mono" data-pj-tag>
              <span>{p.name}</span>
              <span>{p.city ?? p.sector}</span>
            </p>
          </div>

          <div class="pj-info wrap" data-pj-info>
            <div class="pj-main">
              <p class="mono pj-sector">{placeOf(p)}</p>
              <h3 id={`pj-${p.id}`} class="pj-name display" data-pj-name>
                {p.name}
              </h3>
              <p class="pj-blurb" data-pj-fade>
                {p.blurb}
              </p>
            </div>
            <dl class="pj-meta" data-pj-fade>
              <div>
                <dt class="mono">Status</dt>
                <dd>{p.status}</dd>
              </div>
              <div>
                <dt class="mono">Type</dt>
                <dd>{p.sector}</dd>
              </div>
              {p.city && (
                <div>
                  <dt class="mono">Location</dt>
                  <dd>{p.city}</dd>
                </div>
              )}
            </dl>
          </div>
        </article>
      ))
    }

    <div class="pj-hud wrap" aria-hidden="true">
      <span class="mono">Completed</span>
      <span class="pj-bar"><i data-pj-bar></i></span>
      <span class="mono">Scroll</span>
    </div>
  </div>

  <div class="pj-next wrap" aria-labelledby="pj-next-title">
    <div class="pj-next-head">
      <h3 id="pj-next-title" class="pj-next-title display" data-reveal-heading>Under way</h3>
      <p class="pj-next-copy" data-reveal-up>Three residential developments for Land Trades, in design with us now.</p>
      <a href="/projects" class="btn" data-reveal-up>
        All projects
        <span class="btn-icon"><Icon name="solar:arrow-right-linear" /></span>
      </a>
    </div>
    <ul class="pj-next-list">
      {
        ongoing.map((p) => (
          <li data-reveal-up>
            <span class="pj-next-name display">{p.name}</span>
            <span class="mono pj-next-place">{placeOf(p)}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .pj {
    position: relative;
    background: var(--ink);
    padding-top: clamp(96px, 14vh, 180px);
  }
  .pj-head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 20px;
    row-gap: 24px;
    align-items: end;
    padding-bottom: clamp(48px, 8vh, 96px);
  }
  .pj-title {
    grid-column: 1 / span 8;
    font-size: var(--t-2xl);
  }
  .pj-intro {
    grid-column: 9 / -1;
    max-width: 38ch;
    font-size: var(--t-md);
    text-wrap: pretty;
  }

  /* ---------- Default: stacked cards (no-JS / reduced motion) ---------- */
  .pj-stage {
    display: grid;
    gap: clamp(48px, 8vh, 96px);
  }
  .pj-item {
    position: relative;
  }
  .pj-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    max-height: 88vh;
    overflow: hidden;
    background: var(--ink);
  }
  .pj-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pj-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(5 4 13 / 0.92) 0%, rgb(5 4 13 / 0.35) 45%, transparent 70%),
      linear-gradient(to right, rgb(5 4 13 / 0.5), transparent 50%);
  }
  .pj-tag {
    display: none;
  }
  .pj-info {
    display: grid;
    grid-template-columns: 1fr minmax(240px, 0.45fr);
    gap: 20px clamp(20px, 4vw, 64px);
    align-items: end;
    padding-block: 28px;
  }
  .pj-sector {
    color: var(--amber);
    margin-bottom: 12px;
  }
  .pj-name {
    font-size: var(--t-2xl);
  }
  .pj-blurb {
    margin-top: 20px;
    max-width: 48ch;
    font-size: var(--t-md);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .pj-meta {
    display: grid;
    gap: 18px;
  }
  .pj-meta div {
    display: grid;
    gap: 2px;
  }
  .pj-meta dd {
    font-size: var(--t-lg);
    font-weight: 600;
  }
  .pj-meta dt {
    color: var(--mute);
  }
  .pj-hud {
    display: none;
  }

  /* ---------- Enhanced: pinned sequence ---------- */
  :global(.is-pinned) .pj-stage {
    display: block;
    position: relative;
    height: 100svh;
    overflow: clip;
  }
  :global(.is-pinned) .pj-item {
    position: absolute;
    inset: 0;
  }
  :global(.is-pinned) .pj-move {
    position: absolute;
    inset: 0;
    will-change: transform;
  }
  :global(.is-pinned) .pj-frame {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    max-height: none;
    will-change: clip-path;
  }
  :global(.is-pinned) .pj-tag {
    display: block;
    position: absolute;
    left: 34%;
    right: 34%;
    bottom: calc(29% - 2.4em);
    display: flex;
    justify-content: space-between;
    color: var(--bone);
  }
  :global(.is-pinned) .pj-info {
    position: absolute;
    inset: auto 0 0;
    padding-bottom: 96px;
    pointer-events: none;
  }
  :global(.is-pinned) .pj-hud {
    position: absolute;
    inset: auto 0 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 20px;
    padding-block: 24px;
  }
  .pj-hud b {
    color: var(--amber);
    font-weight: 500;
  }
  .pj-bar {
    flex: 1;
    height: 1px;
    background: var(--line-strong);
  }
  .pj-bar i {
    display: block;
    height: 100%;
    background: var(--amber);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }

  /* Ongoing work: the names set large down the right, the heading and the way on at left */
  .pj-next {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 20px;
    row-gap: 48px;
    padding-block: clamp(120px, 18vh, 220px);
  }
  .pj-next-head {
    grid-column: 1 / span 4;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .pj-next-title {
    font-size: var(--t-xl);
    color: var(--amber);
  }
  .pj-next-copy {
    max-width: 30ch;
    text-wrap: pretty;
  }
  .pj-next-list {
    grid-column: 6 / -1;
    display: grid;
    gap: clamp(20px, 3vh, 36px);
  }
  .pj-next-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    flex-wrap: wrap;
  }
  .pj-next-name {
    font-size: var(--t-xl);
    line-height: 1;
  }
  .pj-next-place {
    color: var(--mute);
  }

  @media (max-width: 860px) {
    .pj-info {
      grid-template-columns: 1fr;
    }
    .pj-head > *,
    .pj-next-head,
    .pj-next-list {
      grid-column: 1 / -1;
    }
    /* On a phone the way on follows the list instead of sitting above it */
    .pj-next-head {
      display: contents;
    }
    .pj-next {
      row-gap: 24px;
    }
    .pj-next-head > * {
      grid-column: 1 / -1;
    }
    .pj-next-list {
      margin-block: 16px;
    }
    .pj-next-head .btn {
      order: 1;
      justify-self: start;
    }
    :global(.is-pinned) .pj-info {
      padding-bottom: 80px;
      gap: 14px;
    }
    :global(.is-pinned) .pj-blurb {
      display: none;
    }
    .pj-meta {
      grid-template-columns: 1fr 1fr;
    }
    :global(.is-pinned) .pj-tag {
      left: 12%;
      right: 12%;
      bottom: calc(32% - 2.4em);
    }
  }
</style>
